{
  "$schema": "https://raw.githubusercontent.com/encounter/objdiff/main/config.schema.json",
  "min_version": "2.0.0",
  "build_target": false,
  "target_dir": "build/objdiff/target",
  "base_dir": "build/objdiff/base",
  "watch_patterns": ["*.c", "*.h", "*.s", "*.inc"],
  "progress_categories": [
    { "id": "frontend", "name": "Frontend / Menu" }
  ],
  "units": [
    {
      "name": "frontbin/text",
      "target_path": "build/objdiff/target/text.o",
      "base_path": "build/objdiff/base/text.o",
      "metadata": {
        "source_path": "src/text.c",
        "progress_categories": ["frontend"]
      }
    }
  ]
}
